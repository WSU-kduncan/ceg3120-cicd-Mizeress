[Unit]
Description=Listen for Web Hook
After=network.target

[Service]
ExecStart=/usr/local/bin/webhook -ip 0.0.0.0 -hooks /home/ec2-user/hooks.json -verbose
StandardOutput=append:/var/log/webhook.log
StandardError=append:/var/log/webhook.log
Type=simple
User=ec2-user

[Install]
WantedBy=multi-user.target